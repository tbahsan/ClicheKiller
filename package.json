{
  "name": "clichekiller",
  "version": "0.1.0",
  "private": true,
  "description": "ClicheKiller — Smart, privacy-first detector and 1-click alternative suggester for tired clichés, dead metaphors, and corporate jargon.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cliche",
    "writing",
    "editing",
    "creative-writing",
    "phrase-matching",
    "offline-pwa",
    "typescript"
  ],
  "author": "Tasneem Bin Ahsan",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
